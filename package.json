{
  "name": "human-heart-3d-model",
  "version": "0.5.0",
  "description": "3D model of the human heart to turn and study in one offline HTML file (BodyParts3D, Three.js). A hobby project, not for medical use.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "playwright test --project=chromium",
    "test:unit": "node --test tests/*.test.mjs",
    "test:webkit": "playwright test --project=webkit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panda4th/Human-heart-3D-model.git"
  },
  "keywords": [
    "heart",
    "anatomy",
    "three.js",
    "webgl",
    "bodyparts3d"
  ],
  "author": "Panda4th",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Panda4th/Human-heart-3D-model/issues"
  },
  "homepage": "https://github.com/Panda4th/Human-heart-3D-model#readme",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "1.3.0"
  },
  "private": true
}
